<odoo>

    <record id="view_region_tree" model="ir.ui.view">
        <field name="name">arcs.finance.region.shared.tree</field>
        <field name="model">arcs.finance.region</field>
        <field name="priority" eval="30"/>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="region_type"/>
            </tree>
        </field>
    </record>
    <record id="view_region_form" model="ir.ui.view">
        <field name="name">arcs.finance.region.shared.form</field>
        <field name="model">arcs.finance.region</field>
        <field name="priority" eval="30"/>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="serial_no"/>
                <field name="code"/>
                <field name="name"/>
                <field name="region_type"/>
                <field name="parent_id"/>
                <field name="active"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_region" model="ir.actions.act_window">
        <field name="name">Regions / Zones</field>
        <field name="res_model">arcs.finance.region</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_region_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_region_tree"/>
        <field name="act_window_id" ref="action_region"/>
    </record>
    <record id="action_region_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_region_form"/>
        <field name="act_window_id" ref="action_region"/>
    </record>

    <record id="view_branch_tree" model="ir.ui.view">
        <field name="name">arcs.finance.branch.shared.tree</field>
        <field name="model">arcs.finance.branch</field>
        <field name="priority" eval="30"/>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="region_id"/>
            </tree>
        </field>
    </record>
    <record id="view_branch_form" model="ir.ui.view">
        <field name="name">arcs.finance.branch.shared.form</field>
        <field name="model">arcs.finance.branch</field>
        <field name="priority" eval="30"/>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="serial_no"/>
                <field name="code"/>
                <field name="name"/>
                <field name="region_id"/>
                <field name="active"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">arcs.finance.branch</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_branch_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_branch_tree"/>
        <field name="act_window_id" ref="action_branch"/>
    </record>
    <record id="action_branch_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_branch_form"/>
        <field name="act_window_id" ref="action_branch"/>
    </record>
    <menuitem id="menu_master_data" name="ARCS Finance Data" groups="group_master_data_reader" sequence="59"/>
    <menuitem id="menu_action_region" name="Regions / Zones" parent="menu_master_data" action="action_region" sequence="10"/>
    <menuitem id="menu_action_branch" name="Branches" parent="menu_master_data" action="action_branch" sequence="20"/>
    <menuitem id="menu_arcs_donor_action" name="Donors" parent="menu_master_data" action="arcs_donor_action" sequence="30"/>
    <menuitem id="menu_arcs_finance_program_action" name="Programmes" parent="menu_master_data" action="arcs_finance_program_action" sequence="40"/>
    <menuitem id="menu_arcs_finance_project_action" name="Projects" parent="menu_master_data" action="arcs_finance_project_action" sequence="50"/>
    <menuitem id="menu_arcs_activity_action" name="Activities" parent="menu_master_data" action="arcs_activity_action" sequence="60"/>
</odoo>
