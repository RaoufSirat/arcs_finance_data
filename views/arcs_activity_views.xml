<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="arcs_activity_view_list" model="ir.ui.view">
        <field name="name">arcs.activity.list</field>
        <field name="model">arcs.finance.activity</field>
        <field name="arch" type="xml">
            <tree>
                <field name="serial_no"/><field name="code"/>
                <field name="name"/>
                <field name="project_ids" widget="many2many_tags"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="arcs_activity_view_form" model="ir.ui.view">
        <field name="name">arcs.activity.form</field>
        <field name="model">arcs.finance.activity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Base, Mid &amp; End line - Consultant Fees"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="serial_no"/><field name="code" placeholder="e.g. CIDA0001"/>
                            <field name="project_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="program_ids" widget="many2many_tags" options="{'no_create': True}"/><field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="arcs_activity_view_search" model="ir.ui.view">
        <field name="name">arcs.activity.search</field>
        <field name="model">arcs.finance.activity</field>
        <field name="arch" type="xml">
            <search>
                <field name="serial_no"/><field name="name" string="Activity" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="project_ids" widget="many2many_tags"/>
                <filter name="active_only" string="Active" domain="[('active', '=', True)]"/>
                <filter name="unassigned" string="Not Linked to a Project" domain="[('project_ids', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="arcs_activity_action" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">arcs.finance.activity</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="arcs_activity_view_search"/>
        <field name="context">{'search_default_active_only': 1}</field>
    </record>

</odoo>
