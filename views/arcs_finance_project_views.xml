<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="arcs_finance_project_view_list" model="ir.ui.view">
        <field name="name">arcs.finance.project.list</field>
        <field name="model">arcs.finance.project</field>
        <field name="arch" type="xml">
            <tree>
                <field name="serial_no"/><field name="code"/>
                <field name="name"/>
                <field name="program_ids" widget="many2many_tags"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="arcs_finance_project_view_form" model="ir.ui.view">
        <field name="name">arcs.finance.project.form</field>
        <field name="model">arcs.finance.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Bamyan Flood Response"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="serial_no"/><field name="code" placeholder="e.g. DM01"/>
                            <field name="program_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="activity_ids" widget="many2many_tags" options="{'no_create': True}"/><field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="arcs_finance_project_view_search" model="ir.ui.view">
        <field name="name">arcs.finance.project.search</field>
        <field name="model">arcs.finance.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="serial_no"/><field name="name" string="Project" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="program_ids" widget="many2many_tags"/>
                <filter name="active_only" string="Active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="arcs_finance_project_action" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">arcs.finance.project</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="arcs_finance_project_view_search"/>
        <field name="context">{'search_default_active_only': 1}</field>
    </record>

</odoo>
