<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="arcs_donor_view_list" model="ir.ui.view">
        <field name="name">arcs.donor.list</field>
        <field name="model">arcs.finance.donor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="serial_no"/><field name="code"/>
                <field name="name"/>
                <field name="partner_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="arcs_donor_view_form" model="ir.ui.view">
        <field name="name">arcs.donor.form</field>
        <field name="model">arcs.finance.donor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. International Committee of the Red Cross"/></h1>
                    </div>
                    <group>
                        <field name="serial_no"/><field name="code" placeholder="e.g. ICRC"/>
                        <field name="partner_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="arcs_donor_view_search" model="ir.ui.view">
        <field name="name">arcs.donor.search</field>
        <field name="model">arcs.finance.donor</field>
        <field name="arch" type="xml">
            <search>
                <field name="serial_no"/><field name="name" string="Donor" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="arcs_donor_action" model="ir.actions.act_window">
        <field name="name">Donors</field>
        <field name="res_model">arcs.finance.donor</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="arcs_donor_view_search"/>
    </record>

</odoo>
