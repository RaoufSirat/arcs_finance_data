<odoo>
    <record id="category_master_data" model="ir.module.category">
        <field name="name">ARCS Finance Data</field>
    </record>
    <record id="group_master_data_reader" model="res.groups">
        <field name="name">Master Data Reader</field>
        <field name="category_id" ref="category_master_data"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_master_data_manager" model="res.groups">
        <field name="name">Master Data Manager</field>
        <field name="category_id" ref="category_master_data"/>
        <field name="implied_ids" eval="[(4, ref('group_master_data_reader')), (4, ref('analytic.group_analytic_accounting'))]"/>
    </record>
    <record id="rule_region_company" model="ir.rule">
        <field name="name">ARCS Region company scope</field>
        <field name="model_id" ref="model_arcs_finance_region"/>
        <field name="domain_force">[('analytic_account_id.company_id', 'in', [False] + company_ids)]</field>
    </record>
    <record id="rule_branch_company" model="ir.rule">
        <field name="name">ARCS Branch company scope</field>
        <field name="model_id" ref="model_arcs_finance_branch"/>
        <field name="domain_force">[('analytic_account_id.company_id', 'in', [False] + company_ids)]</field>
    </record>
    <record id="rule_donor_company" model="ir.rule">
        <field name="name">ARCS Donor company scope</field>
        <field name="model_id" ref="model_arcs_finance_donor"/>
        <field name="domain_force">[('analytic_account_id.company_id', 'in', [False] + company_ids)]</field>
    </record>
    <record id="rule_program_company" model="ir.rule">
        <field name="name">ARCS Program company scope</field>
        <field name="model_id" ref="model_arcs_finance_program"/>
        <field name="domain_force">[('analytic_account_id.company_id', 'in', [False] + company_ids)]</field>
    </record>
    <record id="rule_project_company" model="ir.rule">
        <field name="name">ARCS Project company scope</field>
        <field name="model_id" ref="model_arcs_finance_project"/>
        <field name="domain_force">[('analytic_account_id.company_id', 'in', [False] + company_ids)]</field>
    </record>
    <record id="rule_activity_company" model="ir.rule">
        <field name="name">ARCS Activity company scope</field>
        <field name="model_id" ref="model_arcs_finance_activity"/>
        <field name="domain_force">[('analytic_account_id.company_id', 'in', [False] + company_ids)]</field>
    </record>
</odoo>
